# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data (raw data should not be in git, but processed can be versioned)
data/raw/*.xlsx
data/raw/*.csv

# Results (figures and tables can be versioned)
# But keep the directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!results/figures/.gitkeep
!results/tables/.gitkeep
!logs/.gitkeep

# Logs
logs/*.log
logs/*.txt

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.bak
*~
